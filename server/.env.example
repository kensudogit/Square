# ============================================================
# cp .env.example .env してから値を埋める（.env は .gitignore 済み）
# 設定後: npm run preflight で Square への疎通を確認する
#
# sandbox と production では Square の値がすべて別物になる。
# 片方だけ差し替える事故が定番なので、環境ごとに丸ごと入れ替える。
# ============================================================

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# docker compose up -d db で起動する検証用 DB（ホスト 5433）
DATABASE_URL=postgres://square:square@localhost:5433/square_payments

# openssl rand -hex 32 などで生成する
JWT_SECRET=change-me-to-a-long-random-string

# ---- サーバー側（絶対にフロントへ渡さない） -----------------
# sandbox | production
SQUARE_ENVIRONMENT=sandbox

# Developer Dashboard > 対象アプリ > Credentials
SQUARE_ACCESS_TOKEN=

# Webhook subscription ごとに発行される署名キー。
# sandbox と production で別物。取り違えると全 Webhook が 403 になる
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Dashboard に登録した Webhook URL と 1 文字も違ってはいけない。
# 署名計算に使うため、末尾スラッシュ・プロトコル・www の有無まで一致させる。
# ローカル開発では cloudflared / ngrok が払い出した HTTPS URL を入れる
SQUARE_WEBHOOK_NOTIFICATION_URL=https://example.com/api/webhooks/square

# ---- フロントにも渡す（公開されても問題ない） ---------------
# sandbox のアプリ ID は "sandbox-" で始まる
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# ---- アプリ設定 -------------------------------------------
# db:seed で作成するデモユーザー共通のパスワード。
# 未設定なら demo-password-1234。実際に使うパスワードはここに書き、ソースには置かない
SEED_PASSWORD=

CURRENCY=JPY

# 本番障害時に決済受付だけを止めるフラグ（アプリ全体を巻き戻さずに済む）
PAYMENTS_ENABLED=true
